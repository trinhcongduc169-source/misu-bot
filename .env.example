# Sao chép file này thành .env rồi điền key thật vào
# Windows PowerShell: copy .env.example .env
# Mac/Linux:          cp .env.example .env

# Lấy API key tại: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Model mặc định là gpt-4o-mini (rẻ, nhanh, đủ dùng)
# Có thể đổi thành: gpt-4o, gpt-3.5-turbo
OPENAI_MODEL=gpt-4o-mini

# Link form đặt hàng của bạn (Google Form, Tally, Typeform, v.v.)
ORDER_FORM_URL=https://misu-order-api.onrender.com/

# Port chạy local (mặc định 3000)
PORT=3000
